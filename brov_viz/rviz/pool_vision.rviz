Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Pool geometry1
        - /Raw vision robot (expires)1
        - /One-shot aligned odometry (expires)1
        - /AprilTag debug image1
      Splitter Ratio: 0.55
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 110; 120; 130
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Pool floor grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Pool geometry
      Namespaces:
        apriltag: true
        apriltag_axes: true
        labels: true
        pool: true
        pool_axes: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /brov/viz/pool
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Raw vision robot (expires)
      Namespaces:
        vision_robot: true
        vision_robot_axes: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /brov/viz/vision_robot
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: One-shot aligned odometry (expires)
      Namespaces:
        localized_robot: true
        localized_robot_axes: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /brov/viz/localized_robot
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: AprilTag debug image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /brov/aruco/debug_image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 35; 40
    Fixed Frame: pool
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_common/Identity
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.2
      Focal Point:
        X: 2.0
        Y: 0.85
        Z: 0.45
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Pool overview
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.7
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1500
  X: 40
  Y: 40
