#!/usr/bin/env bash
# macOS에서 XQuartz를 준비하고 BROV container shell에 진입한다.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
XHOST=/opt/X11/bin/xhost

if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "이 스크립트는 Docker Desktop for Mac 전용입니다." >&2
    exit 1
fi
if [[ ! -x "${XHOST}" ]]; then
    echo "XQuartz가 설치되어 있지 않습니다: https://www.xquartz.org/" >&2
    exit 1
fi

current_nolisten="$(defaults read org.xquartz.X11 nolisten_tcp 2>/dev/null || true)"
if [[ "${current_nolisten}" != "0" ]]; then
    defaults write org.xquartz.X11 nolisten_tcp -bool false
    killall XQuartz >/dev/null 2>&1 || true
fi
open -a XQuartz

x11_ready=false
for _ in {1..40}; do
    if DISPLAY=:0 "${XHOST}" >/dev/null 2>&1; then
        x11_ready=true
        break
    fi
    sleep 0.25
done
if [[ "${x11_ready}" != "true" ]]; then
    echo "XQuartz display :0이 준비되지 않았습니다." >&2
    exit 1
fi

cleanup() {
    DISPLAY=:0 "${XHOST}" -localhost >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM
DISPLAY=:0 "${XHOST}" +localhost >/dev/null

cd "${PROJECT_DIR}"
docker compose up -d
if (( $# > 0 )); then
    docker compose exec brov bash -lc \
        'source /workspace/brov_ros2/docker/ros_env.sh && exec "$@"' -- "$@"
else
    docker compose exec brov bash -lc \
        'source /workspace/brov_ros2/docker/ros_env.sh && exec bash -i'
fi
